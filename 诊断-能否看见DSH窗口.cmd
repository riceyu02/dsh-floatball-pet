@echo off
rem ===========================================================================
rem  Diagnostic: can a NORMALLY started process SEE the DeepSeek Harness window?
rem
rem  The ball cannot raise the window because its process cannot enumerate it at
rem  all (every focus route reports "no window"). This asks whether that is a
rem  property of the machine or only of the process tree the ball was started in.
rem
rem  Comments stay ASCII: cmd reads .cmd in the OEM code page.
rem ===========================================================================
chcp 65001 >nul
echo.
echo   === send me the lines below ===
echo.
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
echo.
echo   ==============================
echo.
pause
