@echo off
rem ===========================================================================
rem  Diagnostic: can a NORMALLY started process on this machine compile C#?
rem
rem  Clicking the ball fails because the app compiles a short piece of C# (to
rem  raise a window) and Windows refuses with "Access is denied". Add-Type does
rem  that by spawning a temporary csc.exe, so what is refused is creating a
rem  child process.
rem
rem  This runs from your desktop, outside the app process tree:
rem    ok here    -> machine fine, the app own process tree is what is limited
rem    fails here -> this machine/account blocks child processes globally and the
rem                  app needs a route that does not compile C# at runtime
rem
rem  Comments are ASCII on purpose: cmd reads batch files in the OEM code page,
rem  so UTF-8 Chinese here would corrupt the script itself.
rem ===========================================================================
chcp 65001 >nul
echo.
echo   === send me the lines below ===
echo.
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
echo.
echo   ==============================
echo.
pause
