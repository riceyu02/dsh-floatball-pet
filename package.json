{
  "name": "dsh-floatball-pet",
  "productName": "DSH 悬浮球",
  "version": "0.3.1",
  "description": "DeepSeek Harness 悬浮球插件：悬浮球 + 灵动岛（余额 / 运行时间）+ 设置面板，点击悬浮球唤起 DSH。",
  "author": "Riceyu02",
  "license": "MIT",
  "homepage": "https://github.com/riceyu02/dsh-floatball-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riceyu02/dsh-floatball-pet.git"
  },
  "bugs": {
    "url": "https://github.com/riceyu02/dsh-floatball-pet/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "pet",
    "floating-ball"
  ],
  "type": "commonjs",
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "src/main.js",
  "exports": {
    ".": "./plugin/client-host.mjs",
    "./host": "./plugin/host.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "electron . --dev",
    "build:dsh-plugin": "node tools/build-dsh-plugin.cjs",
    "prepare": "node tools/prepare-install.cjs",
    "postinstall": "node tools/prepare-install.cjs",
    "test": "node tools/check-apply-script.cjs && node --test test/*.test.mjs"
  },
  "files": [
    "plugin",
    "client.js",
    "cordis.patch.yml",
    "tools/prepare-install.cjs",
    "tools/assemble.cjs",
    "tools/build-focus-dll.cjs",
    "tools/focus-agent.cjs",
    "src",
    "build/PetFocus.dll",
    "build/icon.ico",
    "node_modules/koffi",
    "node_modules/@koromix/koffi-win32-x64",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.7-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@koromix/koffi-win32-x64": "3.3.1",
    "koffi": "3.3.1"
  },
  "bundledDependencies": [
    "@koromix/koffi-win32-x64",
    "koffi"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "electron": "33.4.11",
    "tar": "^7.5.22"
  }
}
